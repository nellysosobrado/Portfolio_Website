@*
Grundlayout: <head>, gemensamma CSS/JS, samt plats för body via RenderBody().
*@
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>@ViewData["Title"] - Nylegna Kir Portfolio </title>


    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/unicons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/owl.carousel.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/owl.theme.default.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tooplate-style.css" asp-append-version="true" />
</head>
<body>
    @* Navbar *@
    <partial name="~/Pages/Shared/Partials/_Navbar.cshtml" />


    @RenderBody()


    @* Footer *@
    <partial name="~/Pages/Shared/partials/_Footer.cshtml" />


    @* Scripts – ordningen är viktig *@
    <script src="~/js/jquery-3.3.1.min.js" asp-append-version="true"></script>
    <script src="~/js/popper.min.js" asp-append-version="true"></script>
    <script src="~/js/bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/js/Headroom.js" asp-append-version="true"></script>
    <script src="~/js/jQuery.headroom.js" asp-append-version="true"></script>
    <script src="~/js/owl.carousel.min.js" asp-append-version="true"></script>
    <script src="~/js/smoothscroll.js" asp-append-version="true"></script>
    <script src="~/js/custom.js" asp-append-version="true"></script>


    @RenderSection("Scripts", required: false)
</body>
</html>